NEXTJS_ENV=development
BETTER_AUTH_SECRET=dev-secret-must-be-at-least-32-chars!!
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated browser origins for preview/custom domains:
# VTH_AUTH_ORIGINS=https://preview.example.com
#
# OAuth providers stay disabled until both values for that provider are set:
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# ZALO_APP_ID=
# ZALO_APP_SECRET=


# Cloudflare Turnstile — use your own keys, or these always-pass test keys locally:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Production: set secrets with Wrangler (never commit the real values)
#   wrangler secret put BETTER_AUTH_SECRET
#   wrangler secret put TURNSTILE_SECRET_KEY
#   wrangler secret put FACEBOOK_CLIENT_SECRET
#   wrangler secret put ZALO_APP_SECRET
