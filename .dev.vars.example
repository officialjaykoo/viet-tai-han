NEXTJS_ENV=development
BETTER_AUTH_SECRET=dev-secret-must-be-at-least-32-chars!!
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated browser origins for preview/custom domains:
# VTH_AUTH_ORIGINS=https://preview.example.com
#
# Social OAuth — configure at least one provider for local sign-up/sign-in.
# Facebook and Zalo require both values. Kakao requires the client ID; the
# client secret is optional unless it is enabled in the Kakao app.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# ZALO_APP_ID=
# ZALO_APP_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# Cloudflare Turnstile — use your own keys, or these always-pass test keys locally:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Web Push (optional locally; generate one VAPID P-256 key pair)
# VAPID_PUBLIC_KEY=base64url-uncompressed-P256-public-key
# VAPID_PRIVATE_KEY=base64url-P256-private-scalar
# VAPID_SUBJECT=mailto:ops@example.com
# Billing webhook (optional until a provider and policy are approved)
# BILLING_WEBHOOK_SECRET=generate-a-long-random-secret

# Production: set secrets with Wrangler (never commit the real values)
#   wrangler secret put BETTER_AUTH_SECRET
#   wrangler secret put TURNSTILE_SECRET_KEY
#   wrangler secret put FACEBOOK_CLIENT_SECRET
#   wrangler secret put ZALO_APP_SECRET
#   wrangler secret put KAKAO_CLIENT_SECRET  # optional when enabled in Kakao
#   wrangler secret put VAPID_PRIVATE_KEY
#   wrangler secret put VAPID_SUBJECT
