{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "red-vitest",
	"main": "./tests/workers/test-worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "red-db",
			"database_id": "local-db-id",
			"migrations_dir": "./migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "POST_OBJECT",
				"class_name": "PostObject"
			},
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PostObject"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ChatRoom"]
		}
	]
}
