{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vth",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vth-db",
			// Replace after: npx wrangler d1 create vth-db
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "./migrations"
		}
	],
	// Optional — app falls back to isolate memory if omitted
	// "kv_namespaces": [{ "binding": "CACHE", "id": "...", "preview_id": "..." }],
	"durable_objects": {
		"bindings": [
			{
				"name": "POST_OBJECT",
				"class_name": "PostObject"
			},
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PostObject"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ChatRoom"]
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "vth-media"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "vth-posts"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:3000",
		"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
	},
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	},
	"ratelimits": [
		{
			"name": "EDGE_IP_RATE_LIMITER",
			"namespace_id": "91001",
			"simple": {
				"limit": 400,
				"period": 60
			}
		},
		{
			"name": "TUNNEL_IP_RATE_LIMITER",
			"namespace_id": "91002",
			"simple": {
				"limit": 90,
				"period": 60
			}
		},
		{
			"name": "EXPENSIVE_IP_RATE_LIMITER",
			"namespace_id": "91003",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
