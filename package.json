{
  "name": "viet-tai-han",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv /tmp/cloudflare-env.full.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:reset:local": "npm run db:migrate:local && npm run db:seed:local",
    "vectors:create": "wrangler vectorize create vth-posts --dimensions=768 --metric=cosine",
    "test": "npm run test:unit && npm run test:workers",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:integration": "vitest run --config vitest.workers.config.mts tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-desktop",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/core": "1.6.26",
    "@opennextjs/cloudflare": "^1.20.2",
    "better-auth": "1.6.26",
    "better-call": "1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jpeg-js": "^0.4.4",
    "kysely": "^0.29.4",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "pngjs": "^7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-virtuoso": "^4.18.11",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
